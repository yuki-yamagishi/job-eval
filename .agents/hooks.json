{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/handlers/safetyGuard.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "branch-dor-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/handlers/branchDoRGate.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pre-pr-audit-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/handlers/prePrAuditGate.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "review-loop-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stopHook.js",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/handlers/postPrCreate.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
