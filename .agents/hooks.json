{
  "loop-engineering-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stopHook.js",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/preToolHook.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/postToolHook.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
